# Copy to .env for local development: cp .env.example .env
# The API reads this file; the web app only needs API_URL.

# MongoDB with Atlas Search: `docker compose up -d` starts one on 27018. directConnection is needed because
# its replica set advertises a name only the container can resolve. Use your Atlas connection string instead
# if you have a cluster. A plain mongod works for everything except searching.
MONGODB_URI=mongodb://127.0.0.1:27018/atlas_ai?directConnection=true
API_PORT=4002
API_URL=http://127.0.0.1:4002
SITE_ORIGIN=http://localhost:3002

# Signs the session cookie. This value is for local development only; the API refuses to start in
# production with it. Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-before-deploying

REDIS_URL=redis://127.0.0.1:6379

# Where uploaded files are kept: "local" (a folder, for development) or "s3" (S3, R2 or MinIO).
STORAGE_DRIVER=local
UPLOAD_DIR=../../.data/uploads
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=atlas-uploads
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# How passages are turned into vectors. "hash" needs nothing and matches shared words only, which is
# enough to run the pipeline. For real answers use "ollama" (local) or "openai" (needs OPENAI_API_KEY).
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=256
# OLLAMA_URL=http://127.0.0.1:11434
# OPENAI_API_KEY=

# Passages a question gets, how many candidates each search contributes first, and the reranker
# ("none" or "coverage"). Week 5 measures which is better.
# RETRIEVAL_LIMIT=8
# RETRIEVAL_POOL=30
# RERANKER=none

# The model that writes answers. "extractive" needs nothing: it answers by quoting the passages it is given,
# which is enough to see the whole chat working. Real answers need one of the others.
LLM_PROVIDER=extractive
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# (OPENAI_API_KEY and OLLAMA_URL are above)
# A pause between words for the extractive provider, so streaming can be seen: EXTRACTIVE_DELAY_MS=40
# CHAT_MAX_OUTPUT_TOKENS=1024
# CHAT_HISTORY_MESSAGES=6
# CHAT_FIRST_TOKEN_TIMEOUT_MS=30000
# CHAT_TOTAL_TIMEOUT_MS=120000
