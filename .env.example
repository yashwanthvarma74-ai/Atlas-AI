# Copy to .env for local development: cp .env.example .env
# The API reads this file; the web app only needs API_URL.

MONGODB_URI=mongodb://127.0.0.1:27017/atlas_ai
API_PORT=4002
API_URL=http://127.0.0.1:4002
SITE_ORIGIN=http://localhost:3002

# Signs the session cookie. This value is for local development only; the API refuses to start in
# production with it. Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-before-deploying

REDIS_URL=redis://127.0.0.1:6379

# Where uploaded files are kept: "local" (a folder, for development) or "s3" (S3, R2 or MinIO).
STORAGE_DRIVER=local
UPLOAD_DIR=../../.data/uploads
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=atlas-uploads
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# How passages are turned into vectors. "hash" needs nothing and matches shared words only, which is
# enough to run the pipeline. For real answers use "ollama" (local) or "openai" (needs OPENAI_API_KEY).
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=256
# OLLAMA_URL=http://127.0.0.1:11434
# OPENAI_API_KEY=
