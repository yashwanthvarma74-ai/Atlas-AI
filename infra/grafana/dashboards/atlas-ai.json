{
  "uid": "atlas-ai",
  "title": "Atlas AI: requests and ingest",
  "tags": ["atlas"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Answer latency p95 (whole request)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"chat.answer\" } | quantile_over_time(duration, .95)",
          "queryMode": "metrics"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Model time p95 (provider call, to the last word)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"chat.model\" } | quantile_over_time(duration, .95)",
          "queryMode": "metrics"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Retrieval time p95 (embed, vector and keyword search)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"chat.retrieve\" } | quantile_over_time(duration, .95)",
          "queryMode": "metrics"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingest time p95 (one document)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"ingest.document\" } | quantile_over_time(duration, .95)",
          "queryMode": "metrics"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Answers per second",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"chat.answer\" } | rate()",
          "queryMode": "metrics"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failed spans per second",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ status = error } | rate()",
          "queryMode": "metrics"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent answers (open one to see retrieval and model time side by side)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"chat.answer\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    }
  ],
  "description": "Built from spans only. Retrieval and model time are separate spans, so a slow answer can be blamed on one or the other."
}
